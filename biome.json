{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.d.ts", "!**/*.css", "!skills-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "preset": "none"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/schemas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "server-only": "Schema modules are imported by client components, so they must stay server-free."
                },
                "patterns": [
                  {
                    "group": [
                      "~/server/**",
                      "~/generated/**",
                      "~/auth",
                      "~/auth/**"
                    ],
                    "message": "Schema modules are imported by client components, so they must stay server-free."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "dev",
    "enabled": true,
    "useIgnoreFile": true
  }
}
