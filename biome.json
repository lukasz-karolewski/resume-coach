{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.d.ts",
      "!pnpm-lock.yaml",
      "!skills-lock.json",
      "!.agents/skills/para-memory-files",
      "!.agents/skills/better-auth-best-practices",
      "!.agents/skills/langgraph-docs",
      "!.agents/skills/langgraph-fundamentals",
      "!.agents/skills/langgraph-human-in-the-loop",
      "!.agents/skills/vercel-cli",
      "!.agents/skills/vercel-composition-patterns",
      "!.agents/skills/vercel-react-best-practices",
      "!.agents/skills/web-design-guidelines"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "tailwind": "recommended"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "preset": "none"
      },
      "nursery": {
        "noTailwindLegacyUtilities": "error",
        "useTailwindShorthandClasses": "error",
        "useTailwindSortedClasses": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/schemas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "server-only": "Schema modules are imported by client components, so they must stay server-free."
                },
                "patterns": [
                  {
                    "group": [
                      "~/server/**",
                      "~/generated/**",
                      "~/auth",
                      "~/auth/**"
                    ],
                    "message": "Schema modules are imported by client components, so they must stay server-free."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "root": true,
  "tailwind": {
    "stylesheet": "./src/app/styles.css"
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "dev",
    "enabled": true,
    "useIgnoreFile": true
  }
}
